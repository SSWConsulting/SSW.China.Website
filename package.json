{
  "name": "ssw-cn-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SSW.cn 首页 — 让 AI 真正落地企业业务",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "seo": "node scripts/seo.mjs",
    "seo:check": "node scripts/seo.mjs --check",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run format:check && npm run contrast && npm run seo:check && vite build",
    "preflight": "npm run verify && npm run check:assets"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@types/node": "^26.6.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "cobe": "^2.0.1"
  }
}
