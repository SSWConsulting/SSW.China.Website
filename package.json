{
  "name": "ssw-cn-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SSW.cn 首页 — 让 AI 真正落地企业业务",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run typecheck && astro build",
    "preview": "astro preview --port 4173",
    "typecheck": "astro check",
    "check:assets": "node scripts/check-assets.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "seo": "node scripts/seo.mjs",
    "seo:check": "node scripts/seo.mjs --check",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run format:check && npm run contrast && astro build && npm run seo:check",
    "preflight": "npm run verify && npm run check:assets"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/inter": "^5.2.5",
    "@tinacms/cli": "4.0.2",
    "@types/node": "^26.6.1",
    "prettier": "^3.4.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tinacms": "3.14.4",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "astro": "7.3.8",
    "cobe": "^2.0.1"
  }
}
