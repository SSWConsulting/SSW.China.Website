---
/**
 * AI 应用定制。文案：content/pages/ai-apps.json（后台「页面：AI 应用定制」）；
 * 首屏与四张切入点卡片的配图在「站点设置 → AI 应用定制页素材」（带占位闸门）。
 */
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import Editable from '../../components/Editable.astro';
import AppsMain from '../../components/pages/AppsMain.astro';
import { site } from '../../config/site.ts';
import { areaServed, serviceType } from '../../lib/structured-data.ts';
import { faqText, loadApps } from '../../lib/service.ts';

const c = loadApps();
const path = '/services/ai-apps/';
const origin = site.seo.origin;
---

<Base title={c.seo.title} description={c.seo.description} path={path} bodyClass="aiapps-page">
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: c.name,
      description: c.seo.description,
      serviceType: c.name,
      category: serviceType,
      provider: { '@id': `${origin}/#organization` },
      areaServed,
      url: `${origin}${path}`,
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'AI 服务', item: `${origin}/#ai-services` },
        { '@type': 'ListItem', position: 3, name: c.name },
      ],
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: c.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: faqText(f) },
      })),
    }}
  />

  <Editable as="main" island="apps" id="main" tabindex="-1" primary><AppsMain c={c} /></Editable>
</Base>
