---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site.ts';
import { need, ld } from '../../lib/template.ts';
import CardWorkflow from '../../components/partials/CardWorkflow.astro';
import CardApps from '../../components/partials/CardApps.astro';
---

<Base
  title="AI 底座中台｜SSW"
  description="从工具选型、企业账号到网络和权限，我们帮你搭好团队使用 AI 的基础环境，再把常用配置和使用方法整理好，方便同事上手、共享和管理。"
  path="/services/ai-platform/"
  bodyClass="service-design-page service-design-page--ai-platform"
>
<script slot="head" is:inline type="application/ld+json" set:html={ld(`{
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "AI 底座中台",
        "description": "从工具选型、企业账号到网络和权限，我们帮你搭好团队使用 AI 的基础环境，再把常用配置和使用方法整理好，方便同事上手、共享和管理。",
        "serviceType": "AI 底座中台",
        "provider": {
          "@id": "${need(site.seo?.origin, 'seo.origin')}/#organization"
        },
        "areaServed": {
          "@type": "Country",
          "name": "中国"
        },
        "url": "${need(site.seo?.origin, 'seo.origin')}/services/ai-platform/"
      }`)} />
<script slot="head" is:inline type="application/ld+json" set:html={ld(`{
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "首页",
            "item": "${need(site.seo?.origin, 'seo.origin')}/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "AI 服务",
            "item": "${need(site.seo?.origin, 'seo.origin')}/#ai-services"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": "AI 底座中台"
          }
        ]
      }`)} />
<script slot="head" is:inline type="application/ld+json" set:html={ld(`{
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "是不是一开始就要建设完整中台？",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "不需要。通常从一个有明确价值的共性能力和一两个真实场景开始，再根据使用情况扩展。"
            }
          },
          {
            "@type": "Question",
            "name": "能接入我们已经在用的模型和云服务吗？",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "可以。方案会结合现有技术栈、采购协议、部署环境与合规要求设计。"
            }
          },
          {
            "@type": "Question",
            "name": "企业知识如何控制访问权限？",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "知识检索应继承企业原有的身份与权限规则，让用户只能获得其本来就有权访问的信息。"
            }
          },
          {
            "@type": "Question",
            "name": "如何避免被单一模型绑定？",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "通过统一的模型接入层隔离业务应用与供应商接口，并用评估数据支持模型切换。"
            }
          }
        ]
      }`)} />


    <main id="main" tabindex="-1">
      <nav class="breadcrumb" aria-label="面包屑">
        <div class="container">
          <ol>
            <li><a href="/">首页</a></li>
            <li><a href="/#ai-services">AI 服务</a></li>
            <li aria-current="page">AI 底座中台</li>
          </ol>
        </div>
      </nav>

      {/* 页面标题与导语不挂 data-reveal —— 首屏文字必须立即可读（交接文档 §4）。 */}
      <section class="section page-head" aria-labelledby="page-title">
        <div class="service-hero-media" aria-hidden="true">
          <img src="/media/services/ai-platform-hero.png" width="1916" height="821" alt="" fetchpriority="high" />
        </div>
        <div class="container page-head__inner">
          <div class="page-head__copy">
            <h1 id="page-title">AI 底座中台</h1>
            <p class="lead page-head__lede">让团队用得上，公司管得好</p>
            <p class="page-head__body">
              从工具选型、企业账号到网络和权限，我们帮你搭好团队使用 AI
              的基础环境，再把常用配置和使用方法整理好，方便同事上手、共享和管理。
            </p>
            <div class="btn-row page-head__actions">
              <a class="btn btn--primary" href="#wecom" data-wecom>联系我们</a>
              <a class="btn" href="#usecases">查看典型场景</a>
            </div>
          </div>
        </div>
      </section>

      <section class="section-lg pillars" aria-labelledby="platform-value-title">
        <div class="container">
          <div class="head" data-reveal-group>
            <p class="eyebrow" data-reveal>为什么需要 AI 底座中台</p>
            <h2 id="platform-value-title" class="display" data-reveal data-words>让好用的 AI，从个人走向团队</h2>
          </div>
          <div class="pillars__body">
            <p class="pillars__intro" data-reveal>
              有人自己买账号，有人还不会用，好用的方法也只留在个人手里。我们帮你把工具、管理和共享方式安排好，让团队少一些重复摸索。
            </p>
            <ol class="pillars__list" data-reveal-group>
              <li class="pillar" data-reveal>
                <span class="pillar__num" aria-hidden="true">I</span>
                <div>
                  <h3 class="pillar__title">同事容易上手</h3>
                  <p class="pillar__text">配好工具和访问方式，整理上手说明，让需要使用的同事能开始工作。</p>
                </div>
              </li>
              <li class="pillar" data-reveal>
                <span class="pillar__num" aria-hidden="true">II</span>
                <div>
                  <h3 class="pillar__title">公司方便管理</h3>
                  <p class="pillar__text">理清账号、成员权限和费用，明确谁能用什么、由谁负责管理。</p>
                </div>
              </li>
              <li class="pillar" data-reveal>
                <span class="pillar__num" aria-hidden="true">III</span>
                <div>
                  <h3 class="pillar__title">经验可以共享</h3>
                  <p class="pillar__text">把常用提示词、Skill 和 Agent 配置整理成团队可复用的资源。</p>
                </div>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <section class="section-lg service-usecases" id="usecases" aria-labelledby="platform-usecases-title">
        <div class="container">
          <div class="head" data-reveal-group>
            <p class="eyebrow" data-reveal>典型场景</p>
            <h2 id="platform-usecases-title" class="display" data-reveal data-words>你的团队也有这些情况吗？</h2>
            <p class="head__intro" data-reveal>无论是准备开始，还是已经有人在用，都可以先把团队需要的基础安排好。</p>
          </div>
          <ul class="service-usecases__grid" data-reveal-group>
            <li data-reveal>
              <span>01</span>
              <h3>想用，不知怎么选</h3>
              <p>工具和模型很多，不清楚哪些适合团队，也不知道企业账号怎么买。</p>
            </li>
            <li data-reveal>
              <span>02</span>
              <h3>买了，却没用起来</h3>
              <p>已经买了工具，但账号、访问或上手问题，让不少同事仍然用不上。</p>
            </li>
            <li data-reveal>
              <span>03</span>
              <h3>各用各的，不好管理</h3>
              <p>不同团队自行采购和使用，权限、费用和负责人缺少统一安排。</p>
            </li>
            <li data-reveal>
              <span>04</span>
              <h3>方法留在个人手里</h3>
              <p>有同事用得很好，但提示词、配置和经验没有整理，其他人难以复用。</p>
            </li>
          </ul>
        </div>
      </section>

      {/* 详细说明承接上方标题区，不另设可达名称，避免与 page-title 重复标注。 */}
      <section class="section services page-detail" aria-labelledby="platform-capabilities-title">
        <div class="container">
          <div class="head page-detail__head" data-reveal-group>
            <p class="eyebrow" data-reveal>核心能力</p>
            <h2 id="platform-capabilities-title" class="display display--sm" data-reveal>中台统一管理的三个部分</h2>
          </div>
          <div class="service">
            <div class="service__copy" data-reveal-group>
              <dl class="capabilities">
                <div class="capability" data-reveal>
                  <dt>模型接入统一管理</dt>
                  <dd>
                    统一接入与管理不同模型，让业务应用按需调用；同时提供用量统计，可按团队、应用查看调用次数与费用。
                  </dd>
                </div>
                <div class="capability" data-reveal>
                  <dt>企业知识库</dt>
                  <dd>连接企业文档与知识，让 AI 回答有业务依据。</dd>
                </div>
                <div class="capability" data-reveal>
                  <dt>权限与治理</dt>
                  <dd>结合企业权限要求，管理 AI 能力与知识的访问范围。</dd>
                </div>
              </dl>
              <p class="service__fit" data-reveal>
                <span class="service__fit-label">适合场景</span>
                公司准备使用 AI，或已有零散使用，希望让更多同事用起来并方便管理。
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section-lg scope" id="scope" aria-labelledby="platform-scope-title">
        <div class="container scope__layout">
          <div class="scope__intro" data-reveal>
            <p class="eyebrow">交付范围</p>
            <h2 id="platform-scope-title" class="display">从底层接入，<br />到可管理的平台能力</h2>
            <p class="head__intro">架构、知识、权限与运维一起设计，确保平台能被业务应用持续使用。</p>
            <div class="scope__fit">
              <span class="scope__fit-label">适合这样的你</span>
              <p>公司准备使用 AI，或已有零散使用，希望让更多同事用起来并方便管理。</p>
            </div>
          </div>
          <div class="scope__deliverables" data-reveal-group>
            <details class="deliverable" open data-reveal>
              <summary>
                <span class="deliverable__number">01</span
                ><span class="deliverable__heading"
                  ><span class="deliverable__title">平台架构</span
                  ><span class="deliverable__subtitle">确定能力边界与接入方式</span></span
                ><span class="deliverable__toggle"></span>
              </summary>
              <div class="deliverable__body">
                <p>梳理业务应用、数据来源与现有基础设施，设计可扩展的 AI 服务层。</p>
                <ul class="deliverable__outputs">
                  <li>架构方案</li>
                  <li>模型网关</li>
                  <li>接口规范</li>
                </ul>
              </div>
            </details>
            <details class="deliverable" open data-reveal>
              <summary>
                <span class="deliverable__number">02</span
                ><span class="deliverable__heading"
                  ><span class="deliverable__title">知识与数据</span
                  ><span class="deliverable__subtitle">让回答有企业依据</span></span
                ><span class="deliverable__toggle"></span>
              </summary>
              <div class="deliverable__body">
                <p>连接企业文档与业务数据，建立更新、检索、引用和权限继承机制。</p>
                <ul class="deliverable__outputs">
                  <li>数据连接</li>
                  <li>知识检索</li>
                  <li>来源引用</li>
                </ul>
              </div>
            </details>
            <details class="deliverable" open data-reveal>
              <summary>
                <span class="deliverable__number">03</span
                ><span class="deliverable__heading"
                  ><span class="deliverable__title">治理与运维</span
                  ><span class="deliverable__subtitle">让平台安全、透明、可持续</span></span
                ><span class="deliverable__toggle"></span>
              </summary>
              <div class="deliverable__body">
                <p>配置访问控制、日志、评估与成本监控，为上线后的持续运营建立基础。</p>
                <ul class="deliverable__outputs">
                  <li>权限控制</li>
                  <li>使用审计</li>
                  <li>质量与成本监控</li>
                </ul>
              </div>
            </details>
          </div>
        </div>
      </section>

      <section class="section-lg process" id="process" aria-labelledby="platform-process-title">
        <div class="container">
          <div class="head" data-reveal-group>
            <p class="eyebrow" data-reveal>合作流程</p>
            <h2 id="platform-process-title" class="display" data-reveal data-words>先让一组同事用起来，再逐步推广</h2>
          </div>
          <ol class="process__list" data-reveal-group>
            <li class="pstep" data-reveal>
              <span class="pstep__num">01</span>
              <div>
                <h3 class="pstep__title">了解现状</h3>
                <p class="pstep__text">盘点已有工具、账号和团队遇到的问题。</p>
              </div>
            </li>
            <li class="pstep" data-reveal>
              <span class="pstep__num">02</span>
              <div>
                <h3 class="pstep__title">确定方案</h3>
                <p class="pstep__text">选定工具、管理方式和首批使用人员。</p>
              </div>
            </li>
            <li class="pstep" data-reveal>
              <span class="pstep__num">03</span>
              <div>
                <h3 class="pstep__title">配置试用</h3>
                <p class="pstep__text">搭好环境，和实际使用者一起检查。</p>
              </div>
            </li>
            <li class="pstep" data-reveal>
              <span class="pstep__num">04</span>
              <div>
                <h3 class="pstep__title">推广交接</h3>
                <p class="pstep__text">整理配置与方法，帮助更多同事上手。</p>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="section-lg service-beyond" aria-labelledby="platform-beyond-title">
        <div class="container">
          <div class="head" data-reveal-group>
            <p class="eyebrow" data-reveal>后续可选服务</p>
            <h2 id="platform-beyond-title" class="display" data-reveal data-words>团队用起来之后，还能继续做什么？</h2>
            <p class="head__intro" data-reveal>有了基础环境，可以继续改进具体工作，也可以处理更复杂的系统需求。</p>
          </div>
          <ul class="beyond__grid" data-reveal-group>
            <li class="beyond__item" data-reveal>
              <h3 class="beyond__title">业务自动化</h3>
              <p class="beyond__text">把重复工作整理成可执行的 AI 流程。</p>
            </li>
            <li class="beyond__item" data-reveal>
              <h3 class="beyond__title">AI 辅助开发</h3>
              <p class="beyond__text">帮助研发团队把 AI 用进日常开发。</p>
            </li>
            <li class="beyond__item" data-reveal>
              <h3 class="beyond__title">应用与平台定制</h3>
              <p class="beyond__text">需要专属应用、模型网关或企业 AI 平台时，进一步开发。</p>
            </li>
            <li class="beyond__item" data-reveal>
              <h3 class="beyond__title">FDE 服务</h3>
              <p class="beyond__text">由工程师深入团队，通过驻场或远程协作持续推进。</p>
            </li>
          </ul>
        </div>
      </section>

      <section class="section-lg faq" aria-labelledby="platform-faq-title">
        <div class="container">
          <div class="head" data-reveal-group>
            <p class="eyebrow" data-reveal>问与答</p>
            <h2 id="platform-faq-title" class="display" data-reveal data-words>常见问题</h2>
          </div>
          <div class="faq__list" data-reveal-group>
            <details class="faq__item" data-reveal>
              <summary class="faq__q">是不是一开始就要建设完整中台？</summary>
              <div class="faq__a">
                <p>不需要。通常从一个有明确价值的共性能力和一两个真实场景开始，再根据使用情况扩展。</p>
              </div>
            </details>
            <details class="faq__item" data-reveal>
              <summary class="faq__q">能接入我们已经在用的模型和云服务吗？</summary>
              <div class="faq__a"><p>可以。方案会结合现有技术栈、采购协议、部署环境与合规要求设计。</p></div>
            </details>
            <details class="faq__item" data-reveal>
              <summary class="faq__q">企业知识如何控制访问权限？</summary>
              <div class="faq__a">
                <p>知识检索应继承企业原有的身份与权限规则，让用户只能获得其本来就有权访问的信息。</p>
              </div>
            </details>
            <details class="faq__item" data-reveal>
              <summary class="faq__q">如何避免被单一模型绑定？</summary>
              <div class="faq__a"><p>通过统一的模型接入层隔离业务应用与供应商接口，并用评估数据支持模型切换。</p></div>
            </details>
          </div>
        </div>
      </section>

      <section class="section services page-more" aria-labelledby="more-title">
        <div class="container">
          <div class="section__head" data-reveal-group>
            <span class="accent-rule" data-reveal aria-hidden="true"></span>
            <h2 id="more-title" data-reveal>其他 AI 服务</h2>
          </div>

          <div class="core-cards" data-core-cards>
            <ul class="core-cards__track" data-core-track data-reveal-group>
              <CardWorkflow />
              <CardApps />
            </ul>
            <div class="core-cards__dots" data-core-dots hidden></div>
          </div>
        </div>
      </section>

      {/* 本页收尾文案与其余三个页面共用的 sections/cta.html 不同 ——
           2026-09-18 用户只要求改这一个页面，其余页面保持原文案（用户后续会分开改）。
           因此这里不走 @include，直接内联同一套结构，文案单独维护。
           标记、类名、行为（data-wecom / data-ripple / cta__sheen 扫光）都与
           sections/cta.html 完全一致，改的只是可见文字。 */}
      <section class="section cta" aria-labelledby="cta-title">
        <div class="container cta__inner" data-reveal-group>
          <span class="accent-rule cta__rule" data-reveal aria-hidden="true"></span>
          <h2 id="cta-title" class="cta__title" data-reveal>想让团队一起用好 AI？</h2>
          <p class="lead cta__lead" data-reveal>聊聊你们正在用的工具，以及账号、管理和使用上遇到的问题。</p>
          <div class="btn-row cta__actions" data-reveal>
            <a class="btn btn--primary" href="#wecom" data-wecom data-ripple>联系我们</a>
          </div>
        </div>
        <span class="cta__sheen" aria-hidden="true" data-oneshot="sheen"></span>
      </section>
    </main>
</Base>
