---
/** 落地中国。文案：content/pages/chinafy.json（后台「页面：落地中国」）。内容取自 ssw.cn 现有同名页面。 */
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Editable from '../components/Editable.astro';
import ChinafyMain from '../components/pages/ChinafyMain.astro';
import { site } from '../config/site.ts';
import { chinafy as c } from '../lib/pages.ts';

const path = '/chinafy/';
const origin = site.seo.origin;
---

<Base title={c.seo.title} description={c.seo.description} path={path} bodyClass="chinafy-page">
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: c.name,
      description: c.seo.description,
      serviceType: c.name,
      provider: { '@id': `${origin}/#organization` },
      areaServed: { '@type': 'Country', name: '中国' },
      url: `${origin}${path}`,
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: c.name },
      ],
    }}
  />

  <Editable as="main" island="chinafy" id="main" tabindex="-1" primary><ChinafyMain c={c} /></Editable>
</Base>
