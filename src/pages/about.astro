---
/** 关于我们。文案：content/pages/about.json（后台「页面：关于我们」）；资质列表在「站点设置」（带发布闸门）。 */
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import Editable from '../components/Editable.astro';
import AboutMain from '../components/pages/AboutMain.astro';
import { site } from '../config/site.ts';
import { about as c } from '../lib/pages.ts';

const path = '/about/';
const origin = site.seo.origin;
---

<Base title={c.seo.title} description={c.seo.description} path={path} bodyClass="about-page">
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      url: `${origin}${path}`,
      inLanguage: 'zh-CN',
      name: c.hero.title,
      mainEntity: { '@id': `${origin}/#organization` },
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: c.name },
      ],
    }}
  />

    <Editable as="main" island="about" id="main" tabindex="-1" primary><AboutMain c={c} /></Editable>
</Base>
