---
/**
 * 可视化编辑的「岛」包裹元素：输出 `data-tina-island` 等标记，**线上页面也带**（DECISIONS §120）。
 *
 * 标记只是几个 data 属性，访客访问时没有任何作用。页面被编辑后台（/admin/）用 iframe 打开时，
 * src/scripts/visual-editing.ts 加载 bridge：它据此找到这些区域、注册表单，每次按键把草稿 POST 到
 * `/tina-island/<name>`（ssw.cn 上是服务器本机的预览服务，dev 下是 dev/visual-editing/ 注入的端点），
 * 用返回的 HTML 替换本元素。后台预览的就是线上页面本身，不需要另一份带标记的副本。
 *
 * 等价于 `@tinacms/astro` 的 `<TinaIsland>`，自己写是因为它的包裹元素只能带 class，
 * 而这里需要保留 data-reveal-group 等原有属性。
 *
 * 注意：bridge 替换时会换成只带 class 的新元素（见 dev/visual-editing/islands.ts 的 wrapper），
 * 所以包裹元素上不要放 id、aria-* 这类有语义的属性 —— 它们在预览里会在第一次编辑后消失。
 */
interface Props {
  /** 岛名，对应 dev/visual-editing/islands.ts 里的注册项。 */
  island: string;
  /** 包裹元素的标签，默认 div。 */
  as?: string;
  class?: string;
  /** 附加在端点地址上的参数，例如同一模板的多份文档用 `{ slug: 'ai-platform' }` 区分。 */
  params?: Record<string, string>;
  /** 页面上最多一个：后台打开时默认展开它所在的表单。 */
  primary?: boolean;
  /**
   * 预览里按「无脚本」排版显示整页（去掉 html 上的 js 类）。
   * 给依赖脚本状态显示内容的页面用（如 /deck/ 只显示当前一页），否则区块被替换后会全部隐藏。
   */
  staticPreview?: boolean;
  [attr: string]: unknown;
}

const { island, as = 'div', params, primary = false, staticPreview = false, ...attrs } = Astro.props;
const Tag = as;
const marker = `/tina-island/${island}${params ? `?${new URLSearchParams(params)}` : ''}`;
---

<Tag
  {...attrs}
  data-tina-island={marker}
  data-tina-island-primary={primary ? '' : undefined}
  data-tina-static-preview={staticPreview ? '' : undefined}><slot /></Tag>
