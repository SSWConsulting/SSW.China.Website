---
/**
 * 服务详情页模板：AI 底座中台、AI 业务工作流共用。
 * 文案来自 content/pages/<slug>.json（后台「页面：AI 底座中台 / AI 业务工作流」），
 * 两页的结构差异在 lib/service.ts 的 serviceMeta。<main> 的内容在 components/pages/ServiceMain.astro，
 * 与本地可视化编辑端点共用。
 *
 * 结构化数据（Service / BreadcrumbList / FAQPage）由同一份文案生成 ——
 * FAQPage 与页面上可见的问答天然一致（Google 要求两者一致，旧版靠 seo:check 拦漂移）。
 */
import Base from '../../layouts/Base.astro';
import JsonLd from '../JsonLd.astro';
import Editable from '../Editable.astro';
import ServiceMain from '../pages/ServiceMain.astro';
import { site } from '../../config/site.ts';
import { loadService, serviceMeta, type ServiceSlug } from '../../lib/service.ts';

interface Props {
  slug: ServiceSlug;
}

const { slug } = Astro.props;
const c = loadService(slug);
const meta = serviceMeta[slug];
const { path, bodyClass } = meta;
const origin = site.seo.origin;
---

<Base title={c.seo.title} description={c.seo.description} path={path} bodyClass={bodyClass}>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: c.name,
      description: c.seo.description,
      serviceType: c.name,
      provider: { '@id': `${origin}/#organization` },
      areaServed: { '@type': 'Country', name: '中国' },
      url: `${origin}${path}`,
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: `${origin}/` },
        { '@type': 'ListItem', position: 2, name: 'AI 服务', item: `${origin}/#ai-services` },
        { '@type': 'ListItem', position: 3, name: c.name },
      ],
    }}
  />
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: c.faq.items.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }}
  />

  <Editable as="main" island="service" params={{ slug }} id="main" tabindex="-1" primary><ServiceMain c={c} meta={meta} /></Editable>
</Base>
