---
import { site } from '../../config/site.ts';
const adv = site.advantage;
---

{adv && (<>
{/* ══════════════════════════════════════════════════════════════════════
     数据统计 —— 照搬 ssw.com.au 首页 "The SSW Advantage"：
     四栏发丝边栅格，第一格是标题，后三格是数字。没有卡片底色，只有分隔线。
     数字**不做滚动计数**（交接文档 §4 明确禁止）。
     数字是 SSW 已发布的全球口径。出处（ssw.com.au，2026-09-08 取数）
     记在 docs/DECISIONS.md 里，页面上按用户要求不再显示。
     ══════════════════════════════════════════════════════════════════════ */}
<section class="advantage" id="advantage" aria-labelledby="advantage-title">
  <div class="container">
    <div class="advantage__grid" data-reveal-group>
      <div class="advantage__cell advantage__cell--head" data-reveal>
        <h2 id="advantage-title" class="advantage__title">{adv.title}</h2>
      </div>

      {
        adv.stats.slice(0, 3).map((stat) => (
          <div class="advantage__cell" data-reveal>
            <p class="advantage__figure">
              <span class="advantage__number">{stat.figure}</span>
              {stat.suffix && <span class="advantage__suffix">{stat.suffix}</span>}
            </p>
            <h3 class="advantage__label">{stat.label}</h3>
            <p class="advantage__note">{stat.note}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
</>)}
