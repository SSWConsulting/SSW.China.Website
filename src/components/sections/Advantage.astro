---
import { site } from '../../config/site.ts';
import Editable from '../Editable.astro';
import AdvantageBody from './home/AdvantageBody.astro';

interface Props {
  /**
   * 包成可视化编辑的岛（只在首页传）。关于我们、AI 应用定制页上本区块在整块 <main> 的岛里，
   * 再包一层就成了岛中岛。
   */
  editable?: boolean;
}

const { editable = false } = Astro.props;
const adv = site.advantage;
---

{adv && (<>
{/* ══════════════════════════════════════════════════════════════════════
     数据统计 —— 照搬 ssw.com.au 首页 "The SSW Advantage"：
     四栏发丝边栅格，第一格是标题，后三格是数字。没有卡片底色，只有分隔线。
     数字**不做滚动计数**（交接文档 §4 明确禁止）。
     数字是 SSW 已发布的全球口径。出处（ssw.com.au，2026-09-08 取数）
     记在 docs/DECISIONS.md 里，页面上按用户要求不再显示。
     ══════════════════════════════════════════════════════════════════════ */}
<section class="advantage" id="advantage" aria-labelledby="advantage-title">
  {editable ? (
    <Editable island="advantage" class="container"><AdvantageBody adv={adv} /></Editable>
  ) : (
    <div class="container"><AdvantageBody adv={adv} /></div>
  )}
</section>
</>)}
