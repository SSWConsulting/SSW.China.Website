---
import { site } from '../../config/site.ts';
import { need } from '../../lib/template.ts';
---

{site.advantage ? (<>
{/* ══════════════════════════════════════════════════════════════════════
     数据统计 —— 照搬 ssw.com.au 首页 "The SSW Advantage"：
     四栏发丝边栅格，第一格是标题，后三格是数字。没有卡片底色，只有分隔线。
     数字**不做滚动计数**（交接文档 §4 明确禁止）。
     数字是 SSW 已发布的全球口径。出处（ssw.com.au，2026-09-08 取数）
     记在 site.config.ts 的注释与 docs/DECISIONS.md 里，页面上按用户要求不再显示。
     ══════════════════════════════════════════════════════════════════════ */}
<section class="advantage" id="advantage" aria-labelledby="advantage-title">
  <div class="container">
    <div class="advantage__grid" data-reveal-group>
      <div class="advantage__cell advantage__cell--head" data-reveal>
        <h2 id="advantage-title" class="advantage__title">SSW 的积累</h2>
      </div>

      {site.advantage?.stats?.[0] ? (<>
      <div class="advantage__cell" data-reveal>
        <p class="advantage__figure">
          <span class="advantage__number">{need(site.advantage?.stats?.[0]?.figure, 'advantage.stats.0.figure')}</span>
          {site.advantage?.stats?.[0]?.suffix ? (<>
          <span class="advantage__suffix">{need(site.advantage?.stats?.[0]?.suffix, 'advantage.stats.0.suffix')}</span>
          </>) : null}
        </p>
        <h3 class="advantage__label">{need(site.advantage?.stats?.[0]?.label, 'advantage.stats.0.label')}</h3>
        <p class="advantage__note">{need(site.advantage?.stats?.[0]?.note, 'advantage.stats.0.note')}</p>
      </div>
      </>) : null}

      {site.advantage?.stats?.[1] ? (<>
      <div class="advantage__cell" data-reveal>
        <p class="advantage__figure">
          <span class="advantage__number">{need(site.advantage?.stats?.[1]?.figure, 'advantage.stats.1.figure')}</span>
          {site.advantage?.stats?.[1]?.suffix ? (<>
          <span class="advantage__suffix">{need(site.advantage?.stats?.[1]?.suffix, 'advantage.stats.1.suffix')}</span>
          </>) : null}
        </p>
        <h3 class="advantage__label">{need(site.advantage?.stats?.[1]?.label, 'advantage.stats.1.label')}</h3>
        <p class="advantage__note">{need(site.advantage?.stats?.[1]?.note, 'advantage.stats.1.note')}</p>
      </div>
      </>) : null}

      {site.advantage?.stats?.[2] ? (<>
      <div class="advantage__cell" data-reveal>
        <p class="advantage__figure">
          <span class="advantage__number">{need(site.advantage?.stats?.[2]?.figure, 'advantage.stats.2.figure')}</span>
          {site.advantage?.stats?.[2]?.suffix ? (<>
          <span class="advantage__suffix">{need(site.advantage?.stats?.[2]?.suffix, 'advantage.stats.2.suffix')}</span>
          </>) : null}
        </p>
        <h3 class="advantage__label">{need(site.advantage?.stats?.[2]?.label, 'advantage.stats.2.label')}</h3>
        <p class="advantage__note">{need(site.advantage?.stats?.[2]?.note, 'advantage.stats.2.note')}</p>
      </div>
      </>) : null}
    </div>
  </div>
</section>
</>) : null}
