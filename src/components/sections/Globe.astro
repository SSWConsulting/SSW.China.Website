---
import { shared } from '../../lib/shared.ts';
import { br } from '../../lib/content.ts';
import { home } from '../../lib/pages.ts';
---

<section class="section globe" id="offices" aria-labelledby="globe-title">
  <div class="globe__shell">
    <div class="globe__head" data-reveal-group>
      <span class="accent-rule" data-reveal aria-hidden="true"></span>
      <h2 id="globe-title" class="globe__title" data-reveal>{home.globe.title}</h2>
      <p class="globe__subtitle" data-reveal>{home.globe.subtitle}</p>
    </div>

    <div class="globe__grid">
      <div class="globe__offices" data-reveal>
        {/* 杭州地址用中文，取自 ssw.cn 官网原文（未自行翻译）；其余办公室保持英文原文。
             详见 docs/DECISIONS.md §34。办公室列表在「全站通用 → 办公室」里维护。 */}
        {
          shared.offices.map((o) => (
            <div class="office">
              <h3 class="office__heading">
                <button
                  class="office__toggle"
                  type="button"
                  id={`office-${o.slug}-tab`}
                  aria-expanded="true"
                  aria-controls={`office-${o.slug}-panel`}
                  data-office
                  data-lat={String(o.lat)}
                  data-lng={String(o.lng)}
                >
                  <span class="office__name">{o.name}</span>
                  <svg class="office__chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path
                      d="M6 9l6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </button>
              </h3>
              <div class="office__panel" id={`office-${o.slug}-panel`} role="region" aria-labelledby={`office-${o.slug}-tab`}>
                <div class="office__panel-inner">
                  <div class="office__details">
                    <a class="office__row" href={`mailto:${o.email}`}>
                      <svg class="office__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect
                          x="2.5"
                          y="4.5"
                          width="19"
                          height="15"
                          rx="2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                        />
                        <path
                          d="m3 6 9 7 9-7"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        /></svg
                      ><span>{o.email}</span>
                    </a>
                    <a class="office__row" href={o.phoneHref}>
                      <svg class="office__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path
                          d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        /></svg
                      ><span>{o.phone}</span>
                    </a>
                                    <p class="office__row office__row--address">
                      <svg class="office__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path
                          d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linejoin="round"
                        />
                        <circle cx="12" cy="10" r="3" fill="none" stroke="currentColor" stroke-width="1.7" /></svg
                      ><span class="office__address"><Fragment set:html={br(o.address)} /></span>
                    </p>
                    <a class="office__row" href={o.siteUrl} target="_blank" rel="noopener noreferrer">
                      <svg class="office__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path
                          d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        /></svg
                      ><span>{o.siteLabel}</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {/* 地球是补充性图形：所有办公室信息都在左侧列表里，
           WebGL 不可用或脚本未加载时不会丢失任何内容。 */}
      <div class="globe__stage" aria-hidden="true">
        <div class="globe__canvas-wrap">
          <canvas class="globe__canvas" data-globe-canvas></canvas>
        </div>
      </div>
    </div>
  </div>
</section>
