---
import { site } from '../../config/site.ts';
import { home } from '../../lib/pages.ts';

// 第 1 条是主推大卡，第 2–4 条是下方副卡；更多的不渲染（版式只有这四个位置）。
const [lead, ...rest] = site.cases;
const minis = rest.slice(0, 3);
---

{/* ══════════════════════════════════════════════════════════════════════
     案例 —— 照搬 ssw.com.au 首页 Case Studies 的主推卡片：
     360/380px 高、50.625px 大圆角、整幅背景图 + 60% 黑色遮罩、
     客户标志 64px + 标题并排、右侧 64px 圆形箭头（悬停旋转 45° 放大 1.25）。

     cases 为空 ⇒ 整段不渲染，不保留空白、占位卡片或“敬请期待”。

     honesty：backgroundImage 为空时用品牌渐变兜底，绝不放虚构实景照片；
     clientLogo 为空时以客户名纯文字呈现，不留空图框；
     url 为空时整张卡片不是链接、也不显示箭头，不产生死控件；
     isPlaceholder 为真时不再显示可见角标（用户 2026-09-08 要求去掉），
     但仍然阻塞发布：check:assets 对占位案例返回非零。
     占位身份靠文案本身表明 —— 标题以「示例案例…」开头、客户名为「示例客户」。
     ══════════════════════════════════════════════════════════════════════ */}
{
  lead && (
    <section class="section cases" id="cases" aria-labelledby="cases-title">
      <div class="container">
        <div class="section__head" data-reveal-group>
          <span class="accent-rule" data-reveal aria-hidden="true"></span>
          <h2 id="cases-title" data-reveal>{home.cases.title}</h2>
        </div>

        <div class="case-card" data-reveal>
          {lead.backgroundImage && (
            <img
              class="case-card__bg"
              src={lead.backgroundImage.src}
              alt=""
              aria-hidden="true"
              width={lead.backgroundImage.w}
              height={lead.backgroundImage.h}
              loading="lazy"
            />
          )}
          <span class="case-card__scrim" aria-hidden="true"></span>

          <div class="case-card__inner">
            <div class="case-card__copy">
              <div class="case-card__id">
                {lead.clientLogo ? (
                  <img
                    class="case-card__logo"
                    src={lead.clientLogo.src}
                    alt=""
                    aria-hidden="true"
                    width={lead.clientLogo.w}
                    height={lead.clientLogo.h}
                    loading="lazy"
                  />
                ) : (
                  <p class="case-card__client">{lead.clientName}</p>
                )}
                <h3 class="case-card__title">{lead.title}</h3>
              </div>
              <p class="case-card__summary">{lead.summary}</p>
            </div>

            {lead.url && (
              <a class="case-card__link" href={lead.url}>
                <span class="sr-only">查看案例：{lead.title}</span>
                <span class="case-card__arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" fill="currentColor" focusable="false">
                    <path
                      fill-rule="evenodd"
                      d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0z"
                    />
                  </svg>
                </span>
              </a>
            )}
          </div>
        </div>

        {/* 三张副卡：正文在上、16:9 图区在下（与线上一致，注意顺序是反的）。
             窄屏复用核心服务卡那套吸附轮播 + JS 生成的圆点。 */}
        {minis.length > 0 && (
          <div class="core-cards case-minis" data-core-cards>
            <ul class="core-cards__track" data-core-track data-reveal-group>
              {minis.map((c) => (
                <li class="core-cards__slide" data-reveal>
                  <article class="case-mini">
                    <div class="case-mini__body">
                      <div class="case-mini__copy">
                        <h3 class="case-mini__title" data-card-title>{c.title}</h3>
                        <p class="case-mini__summary">{c.summary}</p>
                      </div>

                      {c.url && (
                        <a class="case-mini__link" href={c.url}>
                          <span class="sr-only">查看案例：{c.title}</span>
                          <span class="case-mini__arrow" aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="currentColor" focusable="false">
                              <path
                                fill-rule="evenodd"
                                d="M14 2.5a.5.5 0 0 0-.5-.5h-6a.5.5 0 0 0 0 1h4.793L2.146 13.146a.5.5 0 0 0 .708.708L13 3.707V8.5a.5.5 0 0 0 1 0z"
                              />
                            </svg>
                          </span>
                        </a>
                      )}
                    </div>

                    {/* 图区固定 16:9。没有真实照片时用品牌渐变兜底，绝不放虚构实景照片。 */}
                    <div class="case-mini__media">
                      {c.backgroundImage && (
                        <Fragment>
                          <img
                            class="case-mini__img"
                            src={c.backgroundImage.src}
                            alt=""
                            aria-hidden="true"
                            width={c.backgroundImage.w}
                            height={c.backgroundImage.h}
                            loading="lazy"
                          />
                          <span class="case-mini__scrim" aria-hidden="true"></span>
                        </Fragment>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ul>

            <div class="core-cards__dots" data-core-dots hidden></div>
          </div>
        )}
      </div>
    </section>
  )
}
