---
import { site } from '../../config/site.ts';
import { home } from '../../lib/pages.ts';
import Editable from '../Editable.astro';
import WhyUsBody from './home/WhyUsBody.astro';

const why = site.whyUs;
---

{why && (<>
{/* ══════════════════════════════════════════════════════════════════════
     为什么选择 SSW —— 照搬 ssw.com.au 首页 "Why choose SSW?"。
     线上版式（18px 根字号）：上排 lg 五等分栅格，配图占 3、说明卡占 2，gap 36px；
     下排同样五等分，两条要点占 3（内部再分两栏，gap 72px），资质徽章占 2。
     卡片 圆角 18px / 1px 发丝边 / 底色 #0d0d0d；标题 40.5px/45px；
     要点标题 22.5px/31.5px 600、正文 18px/27px 300；
     徽章胶囊 min-height 40.5px / 圆角全圆 / 内边距 9px 18px / 15.75px。

     与线上的差异见 docs/DECISIONS.md §36：
     · 播放按钮只在 whyUs.videoUrl 有值时渲染 —— 地址为空时左栏是静态配图，
       不出现点了没反应的按钮。当前填的是 B 站地址（见 DECISIONS §42），
       所以按钮会渲染；线上的 YouTube 原址中国大陆打不开，刻意没沿用。
     · 线上那颗按钮整个去掉了（用户 2026-09-09 要求）—— 页面上的咨询入口
       仍有三处（导航、首屏、页尾 CTA），这一块不再重复
     ══════════════════════════════════════════════════════════════════════ */}
<section class="whyus" id="why-us" aria-labelledby="whyus-title">
  <Editable island="whyUs" class="container"><WhyUsBody copy={home.whyUs} why={why} /></Editable>
</section>
</>)}
