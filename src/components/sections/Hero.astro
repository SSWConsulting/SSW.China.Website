---
import { site } from '../../config/site.ts';
import { home } from '../../lib/pages.ts';
import Editable from '../Editable.astro';
import HeroCopy from './home/HeroCopy.astro';

const bg = site.hero.backgroundImage;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__shell">
    <div class="hero__box">
      {
        bg && (
          <img class="hero__media" src={bg.src} alt={bg.alt} width={bg.w} height={bg.h} fetchpriority="high" />
        )
      }
      <span class="hero__scrim" aria-hidden="true"></span>

      <Editable island="hero" class="hero__copy" primary><HeroCopy hero={home.hero} /></Editable>

      {/* 底边凹口：填色与页面底色一致，读作从卡片上咬掉的一口 */}
      <div class="hero__scoop">
        <svg
          class="hero__scoop-shape"
          viewBox="0 0 336 125"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M168 0C129.336 0 107.496 24.1667 88.224 44.75C68.952 65.3333 51.72 83.3333 12 83.3333C8.8174 83.3333 5.76515 85.5283 3.51472 89.4353C1.26428 93.3423 0 98.6413 0 104.167C0 109.692 1.26428 114.991 3.51472 118.898C5.76515 122.805 8.8174 125 12 125H324C327.183 125 330.235 122.805 332.485 118.898C334.736 114.991 336 109.692 336 104.167C336 98.6413 334.736 93.3423 332.485 89.4353C330.235 85.5283 327.183 83.3333 324 83.3333C284.28 83.3333 267.048 65.3333 247.776 44.75C228.504 24.1667 206.664 0 168 0Z"
          />
        </svg>
        <a class="hero__scroll" href="#ai-services" aria-label="向下查看 AI 服务">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M12 5v14M19 12l-7 7-7-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
