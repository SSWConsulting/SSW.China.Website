---
import { site } from '../../config/site.ts';
import { shared } from '../../lib/shared.ts';
const { wecom } = shared;
---

{/*
  企业微信咨询面板。

  这是面板文案的唯一 DOM 来源。JS 关闭时它是页面末尾一个真实可达的区块，
  所有「联系我们」按钮都是指向 #wecom 的真实链接 —— 不存在死控件。
  JS 开启时 wecom-modal.ts 把这个节点整体搬进 <dialog>，并接管锚点点击。
*/}
<section class="wecom" id="wecom" aria-labelledby="wecom-title" data-wecom-panel>
  <div class="wecom__panel">
    <button class="wecom__close" type="button" aria-label="关闭企业微信咨询" data-wecom-close hidden>
      <span aria-hidden="true">✕</span>
    </button>

    <h2 class="wecom__title" id="wecom-title">{wecom.title}</h2>
    <p class="wecom__desc" id="wecom-desc">{wecom.description}</p>

    {site.wecom?.qrImage ? (<>
    <figure class="wecom__qr" data-qr-figure>
      <img
        class="wecom__qr-img"
        data-qr-img
        src={site.wecom.qrImage.src}
        width={site.wecom.qrImage.w}
        height={site.wecom.qrImage.h}
        alt={wecom.qrAlt}
        onerror="this.dataset.failed = '1'"
      />
    </figure>

    <div class="wecom__error" data-qr-error hidden>
      <p class="wecom__error-text">二维码加载失败，请重试</p>
      <button class="btn btn--secondary wecom__retry" type="button" data-qr-retry>重新加载</button>
    </div>

    {/* 桌面那句提示与「打开二维码图片」链接按用户要求去掉 ——
         海报自己带标题，扫码这件事不需要再讲一遍。
         触屏的这句留着：手机上流程不是当场扫，而是保存到相册再从相册选。 */}
    <p class="wecom__hint" data-hint="mobile">{wecom.mobileHint}</p>
    </>) : (<>
    <p class="wecom__pending">{site.wecom.pendingNotice}</p>
    </>)}

    {site.wecom?.searchableId ? (<>
    <div class="wecom__id" data-id-row>
      <p class="wecom__id-text">
        企业微信号：<code class="wecom__id-value" data-id-value>{site.wecom.searchableId}</code>
      </p>
      <button class="btn btn--secondary wecom__copy" type="button" data-id-copy>复制账号</button>
    </div>
    </>) : null}

    <p class="wecom__toast" role="status" aria-live="polite" data-toast hidden></p>
  </div>
</section>
